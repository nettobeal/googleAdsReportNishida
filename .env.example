# Copie este arquivo para .env e preencha com seus valores.
# O .env nunca deve ser commitado (ja esta no .gitignore).

# =========================
# GOOGLE ADS API
# =========================
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Opcional - apenas se voce usa conta gerenciador (MCC)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =========================
# CLIENTES
# =========================
# Cada cliente vira um GOOGLE_ADS_CUSTOMER_ID_<NOME>.
# Selecionar via:  python gerar_relatorio.py --client <NOME>
# Ou:              REPORT_CLIENT=<NOME> python gerar_relatorio.py
GOOGLE_ADS_CUSTOMER_ID_EXEMPLO=1234567890

# =========================
# CLAUDE (opcional - analises por IA)
# =========================
ANTHROPIC_API_KEY=

# =========================
# PERIODO (opcional - default: mes calendario anterior)
# =========================
# REPORT_START=2026-04-01
# REPORT_END=2026-04-30
